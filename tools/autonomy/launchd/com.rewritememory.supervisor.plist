<?xml version="1.0" encoding="UTF-8"?>
<!-- RewriteMemory Supervisor（監視エージェント）の常駐設定（launchd）。
     パスを自分の環境に合わせて編集。StartInterval で定期監視（例: 600秒ごと）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rewritememory.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macmini/gameme/tools/autonomy/supervisor.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/macmini/rewrite-autonomy/logs/supervisor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/macmini/rewrite-autonomy/logs/supervisor.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
